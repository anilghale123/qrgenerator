{
  "name": "qrgenerator",
  "version": "1.0.0",
  "private": true,
  "description": "Upload a PDF, image, or URL and get a QR code that opens it.",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/sync-pdf-worker.mjs && next dev",
    "build": "node scripts/sync-pdf-worker.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:connections": "node --env-file=.env.local scripts/verify-connections.mjs",
    "sync:pdf-worker": "node scripts/sync-pdf-worker.mjs"
  },
  "keywords": [],
  "dependencies": {
    "cloudinary": "^2.10.0",
    "mongodb": "^7.5.0",
    "nanoid": "^6.0.1",
    "next": "^15.5.23",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9"
  }
}
